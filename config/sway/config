include ~/.config/sway/general/*
include ~/.config/sway/colors

# https://github.com/swaywm/sway/issues/5732
include /etc/sway/config.d/*

# java apps
exec export _JAVA_AWT_WM_NONREPARENTING=1

# inputs
input type:pointer scroll_factor 1.2
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}
input type:keyboard {
    xkb_layout "us"
}

# output * bg <image file> fill
