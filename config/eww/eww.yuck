(defwindow example
    :monitor 0
    :geometry (geometry
        :x "0%"
        :y "20px"
        :width "90%"
        :height "30px"
        :anchor "top center"
    )
    :stacking "fg"
    :reserve (struts 
        :distance "40px"
        :side "top"
    )
    :windowtype "desktop"
    :wm-ignore false

    (button
        :onclick "notify-send 'Hello' 'Hello, bro'"
        "Greet"
    )
)